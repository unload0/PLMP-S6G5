@model PLMP_MVC.Controllers.MaintenanceLookupResult

@{
    ViewData["Title"] = "Public Maintenance Lookup";
}

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(to right, #667eea, #764ba2);
    }

    .page-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
    }

    .lookup-card {
        background: white;
        width: 100%;
        max-width: 900px;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    }

    .title {
        text-align: center;
        font-size: 38px;
        font-weight: 900;
        color: #4f46e5;
        margin-bottom: 10px;
    }

    .subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 35px;
    }

    .lookup-form {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .form-control {
        flex: 1;
        min-width: 220px;
        padding: 14px;
        border-radius: 10px;
        border: 1px solid #ccc;
    }

    .btn-search {
        background: linear-gradient(to right, #667eea, #764ba2);
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 10px;
        font-weight: 700;
    }

    .btn-search:hover {
        opacity: 0.9;
    }

    .error-box {
        background: #ffe5e5;
        color: #c0392b;
        padding: 14px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .result-card {
        background: #f8f9ff;
        border-radius: 18px;
        padding: 25px;
        margin-top: 20px;
    }

    .result-title {
        font-size: 28px;
        font-weight: 800;
        color: #4f46e5;
        margin-bottom: 20px;
    }

    .result-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 18px;
    }

    .info-box {
        background: white;
        padding: 18px;
        border-radius: 14px;
        box-shadow: 0 5px 12px rgba(0,0,0,0.05);
    }

    .info-label {
        color: #777;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info-value {
        font-size: 18px;
        font-weight: 700;
        color: #222;
    }
</style>

<div class="page-container">

    <div class="lookup-card">

        <div class="title">
            🔧 Public Maintenance Lookup
        </div>

        <div class="subtitle">
            Enter your maintenance ticket number and registered phone number.
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error-box">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Index" method="post">

            <div class="lookup-form">

                <input type="number"
                       name="requestId"
                       class="form-control"
                       placeholder="Maintenance Ticket Number"
                       required />

                <input type="text"
                       name="phoneNumber"
                       class="form-control"
                       placeholder="Registered Phone Number"
                       required />

                <button type="submit" class="btn-search">
                    Search
                </button>

            </div>

        </form>

        @if (Model != null)
        {
            <div class="result-card">

                <div class="result-title">
                    Maintenance Request Details
                </div>

                <div class="result-grid">

                    <div class="info-box">
                        <div class="info-label">Request ID</div>
                        <div class="info-value">@Model.RequestId</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Tenant Name</div>
                        <div class="info-value">@Model.TenantName</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Category</div>
                        <div class="info-value">@Model.CategoryType</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Priority</div>
                        <div class="info-value">@Model.Priority</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Status</div>
                        <div class="info-value">@Model.Status</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Assigned Staff</div>
                        <div class="info-value">@Model.StaffName</div>
                    </div>

                    <div class="info-box" style="grid-column: 1/-1;">
                        <div class="info-label">Description</div>
                        <div class="info-value">@Model.Description</div>
                    </div>

                </div>

            </div>
        }

    </div>

</div>