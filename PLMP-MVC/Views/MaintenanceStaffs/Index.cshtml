@using PLMP_S6G5.Models

@{
    ViewData["Title"] = "Staff Dashboard";

    var maintenanceRequests = ViewBag.MaintenanceRequests as List<MaintenanceRequest>;
    var maintenanceAssignedRequests = ViewBag.MaintenanceAssignedRequests as List<MaintenanceRequest>;
}

<style>
    .dashboard-title {
        font-size: 34px;
        font-weight: 800;
        color: #312e81;
        margin-bottom: 8px;
    }

    .dashboard-subtitle {
        color: #6b7280;
        margin-bottom: 28px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border-top: 6px solid #4f46e5;
    }

        .stat-card h3 {
            font-size: 16px;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .stat-card h2 {
            font-size: 32px;
            font-weight: 800;
            color: #312e81;
            margin: 0;
        }

    .section-card {
        background: white;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

        .section-card h3 {
            margin-bottom: 18px;
            color: #312e81;
            font-size: 24px;
            font-weight: 700;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table th,
        .custom-table td {
            padding: 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            font-size: 14px;
        }

        .custom-table th {
            background: #eef2ff;
            color: #312e81;
        }

    .btn-action {
        padding: 8px 14px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        color: white;
        margin-right: 6px;
    }

    .btn-approve {
        background: #16a34a;
    }

    .btn-reject {
        background: #dc2626;
    }

    .empty-text {
        color: #6b7280;
        font-style: italic;
    }
</style>

<div>
    <h1 class="dashboard-title">Staff Dashboard</h1>
    <p class="dashboard-subtitle">Manage Requests</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="stats-grid">
    <div class="stat-card">
        <h3>Total Leases</h3>
        <h2>@ViewBag.LeasesCount</h2>
    </div>

    <div class="stat-card">
        <h3>Total Payments</h3>
        <h2>@ViewBag.PaymentsCount</h2>
    </div>

    <div class="stat-card">
        <h3>Maintenance Requests</h3>
        <h2>@ViewBag.RequestsCount</h2>
    </div>
</div>

<div class="section-card">
    <h3>Assigned Maintenance Requests</h3>

    @if (maintenanceAssignedRequests == null || !maintenanceAssignedRequests.Any())
    {
        <p class="empty-text">No assigned requests available.</p>
    }
    else
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Tenant ID</th>
                    <th>Category Type</th>
                    <th>Priority</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Staff ID</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in maintenanceAssignedRequests)
                {
                    <tr>
                        <td>@request.RequestId</td>
                        <td>@request.TenantId</td>
                        <td>@request.CategoryType</td>
                        <td>@request.Priority</td>
                        <td>@request.Description</td>
                        <td>@request.Status</td>
                        <td>@request.StaffId</td>
                        <td>
                            @if (request.Status == "Assigned")
                            {
                                <form asp-action="MarkInProgress" asp-controller="MaintenanceStaffs" method="post" style="display:inline;">
                                    <input type="hidden" name="requestId" value=@request.RequestId />
                                    <button type="submit" class="btn-action btn-approve">Mark As In Progress</button>
                                </form>
                            }
                            else if (request.Status == "In Progress")
                            {
                                <form asp-action="MarkResolved" asp-controller="MaintenanceStaffs" method="post" style="display:inline;">
                                    <input type="hidden" name="requestId" value="@request.RequestId" />
                                    <button type="submit" class="btn-action btn-reject">Mark As Resolved</button>
                                </form>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="section-card">
    <h3>Maintenance Requests</h3>

    @if (maintenanceRequests == null || !maintenanceRequests.Any())
    {
        <p class="empty-text">No maintenance requests available.</p>
    }
    else
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Tenant ID</th>
                    <th>Category Type</th>
                    <th>Priority</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Staff ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in maintenanceRequests)
                {
                    <tr>
                        <td>@request.RequestId</td>
                        <td>@request.TenantId</td>
                        <td>@request.CategoryType</td>
                        <td>@request.Priority</td>
                        <td>@request.Description</td>
                        <td>@request.Status</td>
                        <td>@request.StaffId</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>