                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Buildings" asp-action="Index">Buildings</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Units" asp-action="Index">Units</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payments" asp-action="Index">Payments</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MaintenanceRequests" asp-action="Index">Requests</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tenants" asp-action="Index">Tenants</a>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("User"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="User" asp-action="Dashboard">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Buildings" asp-action="Index">Buildings</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Units" asp-action="Index">Units</a>
                        </li>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Staff"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="MaintenanceStaffs" asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Buildings" asp-action="Index">Buildings</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Units" asp-action="Index">Units</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Leases" asp-action="Index">Leases</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payments" asp-action="Index">Payments</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tenants" asp-action="Index">Tenants</a>
                        </li>
                    }

                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link">@User.Identity.Name</span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="page-container">
        @RenderBody()
    </div>

    <footer>
        &copy; 2026 - PLMP
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>